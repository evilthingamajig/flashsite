{
  "framework": null,
  "installCommand": "exit 0",
  "buildCommand": "exit 0",
  "outputDirectory": ".",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/event",
      "destination": "https://plausible.io/api/event"
    }
  ],
  "redirects": [
    {
      "source": "/events",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/events.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/testimonials",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/testimonials.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/volunteer-adventures",
      "destination": "/volunteering",
      "permanent": true
    },
    {
      "source": "/volunteer-adventures.html",
      "destination": "/volunteering",
      "permanent": true
    },
    {
      "source": "/inspiring-stories",
      "destination": "/mission",
      "permanent": true
    },
    {
      "source": "/inspiring-stories.html",
      "destination": "/mission",
      "permanent": true
    },
    {
      "source": "/archived-members",
      "destination": "/our-team",
      "permanent": true
    },
    {
      "source": "/archived-members.html",
      "destination": "/our-team",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(woff|woff2|otf|ttf|eot)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.(png|jpg|jpeg|gif|webp|svg|ico|avif|mp4|webm|mov)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=2592000"
        }
      ]
    },
    {
      "source": "/(.*)\\.(css|js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
