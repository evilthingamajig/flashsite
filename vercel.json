{
  "framework": null,
  "installCommand": "exit 0",
  "buildCommand": "exit 0",
  "outputDirectory": ".",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/event",
      "destination": "https://plausible.io/api/event"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.flashforwardfoundation.org"
        }
      ],
      "destination": "https://flashforwardfoundation.org/:path*",
      "permanent": true
    },
